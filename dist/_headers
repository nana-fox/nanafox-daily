/*
  X-Content-Type-Options: nosniff
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/daily/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/daily/reader/assets/*
  Cache-Control: public, max-age=31536000, immutable
/daily/latest.json
  Cache-Control: public, max-age=60, must-revalidate
/daily/issues.json
  Cache-Control: public, max-age=0, must-revalidate
